{% block sw_cms_block_enquiry_form_preview %}
    <div class="sw-cms-preview-enquiry-form">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 200">
            <!-- Background -->
            <rect width="300" height="200" fill="#f9fafb"/>
            
            <!-- Form container -->
            <rect x="30" y="20" width="240" height="160" rx="4" fill="#ffffff" stroke="#d1d9e0" stroke-width="1"/>
            
            <!-- Title -->
            <rect x="90" y="35" width="120" height="12" rx="2" fill="#333"/>
            
            <!-- Subtitle -->
            <rect x="100" y="52" width="100" height="8" rx="2" fill="#999"/>
            
            <!-- Name field -->
            <rect x="45" y="75" width="100" height="20" rx="2" fill="#f5f5f5" stroke="#d1d9e0" stroke-width="1"/>
            
            <!-- Email field -->
            <rect x="155" y="75" width="100" height="20" rx="2" fill="#f5f5f5" stroke="#d1d9e0" stroke-width="1"/>
            
            <!-- Phone field -->
            <rect x="45" y="105" width="210" height="20" rx="2" fill="#f5f5f5" stroke="#d1d9e0" stroke-width="1"/>
            
            <!-- Message field -->
            <rect x="45" y="135" width="210" height="30" rx="2" fill="#f5f5f5" stroke="#d1d9e0" stroke-width="1"/>
            
            <!-- Submit button -->
            <rect x="110" y="175" width="80" height="15" rx="3" fill="#007bff"/>
        </svg>
    </div>
{% endblock %}

