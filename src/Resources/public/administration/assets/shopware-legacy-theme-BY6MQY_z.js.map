{% block sw_cms_element_cta_config %}
<div class="sw-cms-el-config-cta">
    {% block sw_cms_element_cta_config_tabs %}
    <sw-tabs default-item="title">
        <template #default="{ active }">
            <sw-tabs-item name="title" :active-tab="active">
                {{ $tc('sw-cms.elements.cta.general.tabs.title') }}
            </sw-tabs-item>
            <sw-tabs-item name="content" :active-tab="active">
                {{ $tc('sw-cms.elements.cta.general.tabs.content') }}
            </sw-tabs-item>
            <sw-tabs-item name="image" :active-tab="active">
                {{ $tc('sw-cms.elements.cta.general.tabs.media') }}
            </sw-tabs-item>
            <sw-tabs-item name="button" :active-tab="active">
                {{ $tc('sw-cms.elements.cta.general.tabs.button') }}
            </sw-tabs-item>
            <sw-tabs-item name="setting" :active-tab="active">
                {{ $tc('sw-cms.elements.cta.general.tabs.settings') }}
            </sw-tabs-item>
        </template>

        <template #content="{ active }">
            <div v-if="active === 'title'" class="sw-cms-el-config-cta__tab-content">
                <div class="sw-field-row">
                    <sw-text-field v-model:value="element.config.title.value" :label="$tc('sw-cms.elements.cta.general.config.title')" />
                    <mt-select v-model="element.config.titleHeading.value" :label="$tc('sw-cms.elements.cta.general.config.title-tag')"
                        :options="[ { label: 'H1', value: 'h1' }, { label: 'H2', value: 'h2' }, { label: 'H3', value: 'h3' }, { label: 'div', value: 'div' } ]" />
                </div>
                <div class="sw-field-row">
                    <sw-text-field v-model:value="element.config.subTitle.value" :label="$tc('sw-cms.elements.cta.general.config.sub-title')" />
                    <mt-select v-model="element.config.subTitleHeading.value" :label="$tc('sw-cms.elements.cta.general.config.sub-title-tag')"
                        :options="[ { label: 'H3', value: 'h3' }, { label: 'H4', value: 'h4' }, { label: 'H5', value: 'h5' }, { label: 'p', value: 'p' } ]" />
                </div>
                <sw-textarea-field v-model:value="element.config.shortDescription.value" :label="$tc('sw-cms.elements.cta.general.config.short-description')" />
            </div>

            <div v-if="active === 'content'" class="sw-cms-el-config-cta__tab-content">
                <mt-text-editor v-model="contentUpdate" :label="$tc('sw-cms.elements.cta.general.config.content.label')" @update:model-value="onElementUpdate" />
            </div>

            <div v-if="active === 'image'" class="sw-cms-el-config-cta__tab-content">
                <sw-cms-mapping-field v-model:config="element.config.mediaDesktop" :label="$tc('sw-cms.elements.cta.general.config.desktop')" entity="media">
                    <sw-media-upload-v2 variant="regular" :upload-tag="uploadTagDesktop" :source="previewSourceDesktop" :allow-multi-select="false" @media-upload-sidebar-open="onOpenMediaModalDesktop" @media-upload-remove-image="onImageRemoveDesktop" />
                </sw-cms-mapping-field>

                <sw-cms-mapping-field v-model:config="element.config.mediaTablet" :label="$tc('sw-cms.elements.cta.general.config.tablet')" entity="media">
                    <sw-media-upload-v2 variant="regular" :upload-tag="uploadTagTablet" :source="previewSourceTablet" :allow-multi-select="false" @media-upload-sidebar-open="onOpenMediaModalTablet" @media-upload-remove-image="onImageRemoveTablet" />
                </sw-cms-mapping-field>

                <sw-cms-mapping-field v-model:config="element.config.mediaMobile" :label="$tc('sw-cms.elements.cta.general.config.mobile')" entity="media">
                    <sw-media-upload-v2 variant="regular" :upload-tag="uploadTagMobile" :source="previewSourceMobile" :allow-multi-select="false" @media-upload-sidebar-open="onOpenMediaModalMobile" @media-upload-remove-image="onImageRemoveMobile" />
                </sw-cms-mapping-field>

                <sw-upload-listener :upload-tag="uploadTagDesktop" auto-upload @media-upload-finish="onImageUploadDesktop" />
                <sw-upload-listener :upload-tag="uploadTagTablet" auto-upload @media-upload-finish="onImageUploadTablet" />
                <sw-upload-listener :upload-tag="uploadTagMobile" auto-upload @media-upload-finish="onImageUploadMobile" />
                
                <sw-media-modal-v2 v-if="mediaModalIsOpenDesktop" @modal-close="onCloseModalDesktop" @media-modal-selection-change="onSelectionChangesDesktop" />
                <sw-media-modal-v2 v-if="mediaModalIsOpenTablet" @modal-close="onCloseModalTablet" @media-modal-selection-change="onSelectionChangesTablet" />
                <sw-media-modal-v2 v-if="mediaModalIsOpenMobile" @modal-close="onCloseModalMobile" @media-modal-selection-change="onSelectionChangesMobile" />
            </div>

            <div v-if="active === 'button'" class="sw-cms-el-config-cta__tab-content">
                <div class="button-config-group">
                    <sw-dynamic-url-field v-model:value="element.config.url1.value" :label="$tc('sw-cms.elements.cta.general.config.button-url')" />
                    <div class="sw-field-row">
                        <sw-text-field v-model:value="element.config.buttonText1.value" :label="$tc('sw-cms.elements.cta.general.config.button-text')" />
                        <mt-select v-model="element.config.buttonType1.value" :label="$tc('sw-cms.elements.cta.general.config.button-type')"
                            :options="[ {label: 'Primary', value: 'primary'}, {label: 'Secondary', value: 'secondary'}, {label: 'Danger', value: 'danger'} ]" />
                    </div>
                    <sw-switch-field v-model:value="element.config.newTab1.value" :label="$tc('sw-cms.elements.cta.general.config.open-link-new-tab')" />
                </div>
            </div>

            <div v-if="active === 'setting'" class="sw-cms-el-config-cta__tab-content">
                <div class="sw-field-row">
                    <mt-select v-model="element.config.titlePosition.value" :label="$tc('sw-cms.elements.cta.general.config.horizontal-alignment')"
                        :options="[ { label: 'Left', value: 'start' }, { label: 'Center', value: 'center' }, { label: 'Right', value: 'end' } ]" />
                    <mt-select v-model="element.config.alignment.value" :label="$tc('sw-cms.elements.general.config.label.alignment')"
                        :options="[ { label: 'Top', value: 'start' }, { label: 'Middle', value: 'center' }, { label: 'Bottom', value: 'end' } ]" />
                </div>
                <sw-text-field v-model:value="element.config.customClass.value" :label="$tc('sw-cms.elements.cta.general.config.custom-class')" />
                <sw-switch-field v-model:value="element.config.active.value" :label="$tc('sw-cms.elements.cta.general.config.enable-element')" />
                <sw-switch-field v-model:value="element.config.lazyLoad.value" :label="$tc('sw-cms.elements.cta.general.config.enable-lazy-load')" />
            </div>
        </template>
    </sw-tabs>
    {% endblock %}
</div>
{% endblock %}