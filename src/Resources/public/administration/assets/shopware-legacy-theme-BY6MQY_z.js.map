            <!-- Form icon -->
            <rect x="40" y="30" width="120" height="15" rx="2" fill="#d1d9e0"/>
            <rect x="40" y="55" width="120" height="15" rx="2" fill="#d1d9e0"/>
            <rect x="40" y="80" width="120" height="15" rx="2" fill="#d1d9e0"/>
            <rect x="40" y="105" width="120" height="40" rx="2" fill="#d1d9e0"/>
