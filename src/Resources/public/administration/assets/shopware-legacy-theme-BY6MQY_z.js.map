{% block sw_cms_block_product_return_form_preview %}
    <div class="sw-cms-preview-product-return-form">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 200">
            <rect width="300" height="200" fill="#f9fafb"/>
            <rect x="30" y="20" width="240" height="160" rx="4" fill="#fff" stroke="#d1d9e0" stroke-width="1"/>

            <!-- Title -->
            <rect x="80" y="35" width="140" height="12" rx="2" fill="#333"/>
            <!-- Subtitle -->
            <rect x="90" y="52" width="120" height="8" rx="2" fill="#999"/>

            <!-- Order/Product fields -->
            <rect x="45" y="75" width="90" height="18" rx="2" fill="#f5f5f5" stroke="#d1d9e0" stroke-width="1"/>
            <rect x="145" y="75" width="110" height="18" rx="2" fill="#f5f5f5" stroke="#d1d9e0" stroke-width="1"/>

            <!-- Reason select -->
            <rect x="45" y="105" width="210" height="18" rx="2" fill="#f5f5f5" stroke="#d1d9e0" stroke-width="1"/>

            <!-- Description -->
            <rect x="45" y="135" width="210" height="30" rx="2" fill="#f5f5f5" stroke="#d1d9e0" stroke-width="1"/>

            <!-- Button -->
            <rect x="110" y="175" width="80" height="15" rx="3" fill="#007bff"/>
        </svg>
    </div>
{% endblock %}

