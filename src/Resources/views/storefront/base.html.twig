{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_body_classes %}
	{{parent()}}
{% endblock %}
{% block base_body_inner %}
	{% block body_background_image %}
		{% set imageAlt = ("legacytheme.cms.siteBackgroundImageAlt"|trans) %}
		{% set bodyBackgroundColor = theme_config('sw-body-background-color') %}
		{% set hasBodyBackgroundColor = bodyBackgroundColor and bodyBackgroundColor|lower != 'transparent' %}
		{% set bodyBackgroundPattern = theme_config('sw-background-pattern-image') %}
		<div class="body-bg"{% if hasBodyBackgroundColor or bodyBackgroundPattern %} style="{% if hasBodyBackgroundColor %}background-color: {{ bodyBackgroundColor }};{% endif %}{% if bodyBackgroundPattern %}background-image: url('{{ bodyBackgroundPattern|sw_encode_url }}');{% endif %}"{% endif %}>
		{% if theme_config('sw-background-image') %}
			<picture>
				<source media="(min-width:768px)" srcset="{{ theme_config('sw-background-image')|sw_encode_url|split('?')[0] }}">
				{% if theme_config('sw-background-image-mobile') %}
				<source media="(min-width:0px)" srcset="{{ theme_config('sw-background-image-mobile')|sw_encode_url|split('?')[0] }}">
				<img src="{{ theme_config('sw-background-image-mobile')|sw_encode_url|split('?')[0] }}" alt="{{imageAlt}}" width="1920" height="1000" loading="eager" fetchpriority="high">
				{% else %}
				<img src="{{ theme_config('sw-background-image')|sw_encode_url|split('?')[0] }}" alt="{{imageAlt}}" width="1920" height="1000" loading="eager" fetchpriority="high">
				{% endif %}
			</picture>
		{% endif %}
		</div>
	{% endblock %}
	{{parent()}}
{% endblock %}
