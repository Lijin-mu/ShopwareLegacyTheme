{% sw_extends '@Storefront/storefront/layout/meta.html.twig' %}


{% block layout_head_stylesheet %}

	{% set pageType = page.cmsPage.type %}

	{% set isProduct = page.product !== null %}

	{% set isHome = controllerAction == "home" %}

	{% set isSearch = controllerAction == "search" %}

	{% set isListing = page.cmsPage.type == "product_list" %}


	<link rel="preload" fetchpriority="high" as="image" href="{{ theme_config('sw-logo-desktop') |sw_encode_url }}"/>
	{% if theme_config('sw-background-image') %}
	<link rel="preload" fetchpriority="high" as="image" href="{{ theme_config('sw-background-image') |sw_encode_url }}" crossorigin="" media="(min-width: 768px)" />
	{% endif %}
	{% if theme_config('sw-background-image-mobile') %}
	<link rel="preload" fetchpriority="high" as="image" href="{{ theme_config('sw-background-image-mobile') |sw_encode_url }}" crossorigin="" media="(max-width: 767px)" />
	{% endif %}
	<link rel="preload" as="font" href="/bundles/shopwarelegacytheme/assets/icons/shopware.woff" crossorigin="" type="font/woff"/>
	<link rel="preload" as="font" href="/bundles/shopwarelegacytheme/assets/fonts/open-sans-fontface/Variable/OpenSans.latin.woff2" crossorigin="" type="font/woff2"/>

	{% set maincss = theme_config('assets.css') %}
	{% for file in maincss %}
		<link rel="preload" as="style" fetchpriority="high" href="{{ asset(file, 'theme') }}"/>
	{% endfor %}


	{% block theme_font %}

		<style>

			@supports not(font-variation-settings: normal) {
				@font-face {
					font-family: 'Open Sans';
					font-display: swap;
					src: local('Open Sans Light'), local('OpenSans-Light'), url('/bundles/shopwarelegacytheme/assets/fonts/open-sans-fontface/Light/OpenSans-Light.woff2') format('woff2'), url('/bundles/shopwarelegacytheme/assets/fonts/open-sans-fontface/Light/OpenSans-Light.woff') format('woff');
					font-weight: 300;
					font-style: normal
				}

				@font-face {
					font-family: 'Open Sans';
					font-display: swap;
					src: local('Open Sans Regular'), local('Open Sans'), url('/bundles/shopwarelegacytheme/assets/fonts/open-sans-fontface/Regular/OpenSans-Regular.woff2') format('woff2'), url('/bundles/shopwarelegacytheme/assets/fonts/open-sans-fontface/Regular/OpenSans-Regular.woff') format('woff');
					font-weight: normal;
					font-style: normal
				}

				@font-face {
					font-family: 'Open Sans';
					font-display: swap;
					src: local('Open Sans Semibold'), local('OpenSans-SemiBold'), url('/bundles/shopwarelegacytheme/assets/fonts/open-sans-fontface/Semibold/OpenSans-Semibold.woff2') format('woff2'), url('/bundles/shopwarelegacytheme/assets/fonts/open-sans-fontface/Semibold/OpenSans-Semibold.woff') format('woff');
					font-weight: 600;
					font-style: normal
				}

				@font-face {
					font-family: 'Open Sans';
					font-display: swap;
					src: local('Open Sans Bold'), local('OpenSans-Bold'), url('/bundles/shopwarelegacytheme/assets/fonts/open-sans-fontface/Bold/OpenSans-Bold.woff2') format('woff2'), url('/bundles/shopwarelegacytheme/assets/fonts/open-sans-fontface/Bold/OpenSans-Bold.woff') format('woff');
					font-weight: bold;
					font-style: normal
				}

				@font-face {
					font-family: 'Open Sans';
					font-display: swap;
					src: local('Open Sans ExtraBold'), local('OpenSans-ExtraBold'), url('/bundles/shopwarelegacytheme/assets/fonts/open-sans-fontface/ExtraBold/OpenSans-ExtraBold.woff2') format('woff2'), url('/bundles/shopwarelegacytheme/assets/fonts/open-sans-fontface/ExtraBold/OpenSans-ExtraBold.woff') format('woff');
					font-weight: 800;
					font-style: normal
				}
			}

			@supports(font-variation-settings: normal) {

				@font-face {
					font-family: 'Open Sans';
					font-style: normal;
					font-weight: 300 800;
					font-display: swap;
					src: url('/bundles/shopwarelegacytheme/assets/fonts/open-sans-fontface/Variable/OpenSans.cyrillic-ext.woff2') format('woff2');
					unicode-range: U + 0460-052F, U + 1C80-1C88, U + 20B4, U + 2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;
				}

				@font-face {
					font-family: 'Open Sans';
					font-style: normal;
					font-weight: 300 800;
					font-display: swap;
					src: url('/bundles/shopwarelegacytheme/assets/fonts/open-sans-fontface/Variable/OpenSans.cyrillic.woff2') format('woff2');
					unicode-range: U + 0301, U + 0400-045F, U + 0490-0491, U + 04B0-04B1, U + 2116;
				}

				@font-face {
					font-family: 'Open Sans';
					font-style: normal;
					font-weight: 300 800;
					font-display: swap;
					src: url('/bundles/shopwarelegacytheme/assets/fonts/open-sans-fontface/Variable/OpenSans.greek-ext.woff2') format('woff2');
					unicode-range: U + 1F00-1FFF;
				}

				@font-face {
					font-family: 'Open Sans';
					font-style: normal;
					font-weight: 300 800;
					font-display: swap;
					src: url('/bundles/shopwarelegacytheme/assets/fonts/open-sans-fontface/Variable/OpenSans.greek.woff2') format('woff2');
					unicode-range: U + 0370-03FF;
				}

				@font-face {
					font-family: 'Open Sans';
					font-style: normal;
					font-weight: 300 800;
					font-display: swap;
					src: url('/bundles/shopwarelegacytheme/assets/fonts/open-sans-fontface/Variable/OpenSans.vietnamese.woff2') format('woff2');
					unicode-range: U + 0102-0103, U + 0110-0111, U + 0128-0129, U + 0168-0169, U + 01A0-01A1, U + 01AF-01B0, U + 1EA0-1EF9, U + 20AB;
				}

				@font-face {
					font-family: 'Open Sans';
					font-style: normal;
					font-weight: 300 800;
					font-display: swap;
					src: url('/bundles/shopwarelegacytheme/assets/fonts/open-sans-fontface/Variable/OpenSans.latin-ext.woff2') format('woff2');
					unicode-range: U + 0100-024F, U + 0259, U + 1E00-1EFF, U + 2020, U + 20A0-20AB, U + 20AD-20CF, U + 2113, U + 2C60-2C7F, U+A720-A7FF;
				}

				@font-face {
					font-family: 'Open Sans';
					font-style: normal;
					font-weight: 300 800;
					font-display: swap;
					src: url('/bundles/shopwarelegacytheme/assets/fonts/open-sans-fontface/Variable/OpenSans.latin.woff2') format('woff2');
					unicode-range: U + 0000-00FF, U + 0131, U + 0152-0153, U + 02BB-02BC, U + 02C6, U + 02DA, U + 02DC, U + 2000-206F, U + 2074, U + 20AC, U + 2122, U + 2191, U + 2193, U + 2212, U + 2215, U+FEFF, U+FFFD;
				}
			}


			@font-face {
				font-family: 'shopware';
				font-display: block;
				src: url("/bundles/shopwarelegacytheme/assets/icons/shopware.woff") format("woff");
				font-weight: normal;
				font-style: normal;
			}
		</style>

	{% endblock %}


	{{ parent() }}


{% endblock %}
