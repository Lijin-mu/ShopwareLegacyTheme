{% block frosh_product_compare_add_to_compare_box %}
    {% set showIconOnly = config('FroshProductCompare.config.showIconOnly') %}
    {# @var product \Shopware\Core\Content\Product\SalesChannel\SalesChannelProductEntity #}
    <div class="compare-button d-grid">
        {% set addToCompareOptions = {
            productId: product.id,
            showIconOnly: showIconOnly,
            defaultText: "legacytheme.general.detailactionlinkcompare"|trans|sw_sanitize,
            addedText: "legacytheme.general.detailactionlinkremovecompare"|trans|sw_sanitize
        } %}
        {% block frosh_product_compare_add_to_compare_button %}
            {% if showIconOnly %}
                <button data-add-to-compare-button="true"
                        data-add-to-compare-button-options="{{ addToCompareOptions|json_encode }}"
                        class="btn btn btn-link btn-block btn-compare"
                        title="{{ "froshProductCompare.general.addToCompare"|trans|striptags }}">
                     <span class="compare-text">{{ "legacytheme.general.detailactionlinkcompare"|trans }}</span>
                </button>
            {% else %}
                <button data-add-to-compare-button="true"
                        data-add-to-compare-button-options="{{ addToCompareOptions|json_encode }}"
                        class="btn btn btn-link btn-block btn-compare"
                        title="{{ "froshProductCompare.general.addToCompare"|trans|striptags }}">
                        <span class="compare-text">{{ "legacytheme.general.detailactionlinkcompare"|trans }}</span>
                </button>
            {% endif %}
        {% endblock %}
    </div>
{% endblock %}
